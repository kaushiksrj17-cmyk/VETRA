# ============================================================
# VETRA PLATFORM -- ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Note: This is an example template. DO NOT put real credentials here.
# Copy this file to .env and supply actual values for your deployment.

# Application Identity & Mode
APP_NAME=VETRA
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Network & Host Binding
HOST=0.0.0.0
PORT=8000

# CORS & Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Connectivity (MongoDB Atlas / Replica Set)
MONGODB_URL=
MONGODB_DATABASE=vetra
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Artificial Intelligence (Google Gemini API)
GEMINI_API_KEY=

# Authentication & Security
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Security Hardening & Rate Limiting
SECURITY_HEADERS_ENABLED=true
MAX_UPLOAD_SIZE_MB=25
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
WEBSOCKET_AUTH_REQUIRED=false

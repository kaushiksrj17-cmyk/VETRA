# Python virtual environment
.venv/
venv/
ENV/
env/

# Python byte-code and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Environment secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# Media uploads and storage artifacts
media/images/*
!media/images/.gitkeep
media/videos/*
!media/videos/.gitkeep
media/thumbnails/*
!media/thumbnails/.gitkeep

# Logs and runtime traces
*.log
logs/

# IDE and OS configurations
.vscode/
.idea/
.DS_Store
Thumbs.db